# TiDB Cloud connection string. Never commit the real value.
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:4000/cashbox_cloud?sslaccept=strict"

# Use a long random secret in production (32+ random characters).
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Optional browser origins if you call the backend directly.
# The Railway-ready frontend normally calls the backend through its server proxy,
# so this may be left empty in production.
FRONTEND_URLS="http://localhost:3000"

# Railway provides PORT automatically. 3001 is only the local fallback.
PORT=3001
