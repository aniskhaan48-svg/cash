generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  action     String    @db.VarChar(100)
  table_name String    @db.VarChar(100)
  record_id  BigInt
  old_values Json?
  new_values Json?
  created_at DateTime? @default(now()) @db.DateTime(0)
}

model cashboxes {
  id           BigInt         @id @default(autoincrement())
  name_ar      String         @db.VarChar(255)
  name_en      String         @db.VarChar(255)
  is_active    Boolean?       @default(true)
  created_at   DateTime?      @default(now()) @db.DateTime(0)
  updated_at   DateTime?      @default(now()) @db.DateTime(0)
  transactions transactions[]
}

model categories {
  id            BigInt          @id @default(autoincrement())
  name_ar       String          @db.VarChar(255)
  name_en       String          @db.VarChar(255)
  type          categories_type
  account_group String          @default("EXPENSE") @db.VarChar(30)
  is_active     Boolean?        @default(true)
  created_at    DateTime?       @default(now()) @db.DateTime(0)
  transactions      transactions[]
  treasury_entries  treasury_entries[]
}

model settings {
  id              BigInt    @id @default(autoincrement())
  company_name_ar String?   @db.VarChar(255)
  company_name_en String?   @db.VarChar(255)
  currency        String?   @default("SAR") @db.VarChar(10)
  logo_url        String?   @db.Text
  created_at      DateTime? @default(now()) @db.DateTime(0)
  updated_at      DateTime? @default(now()) @db.DateTime(0)
}

model transactions {
  id               BigInt            @id @default(autoincrement())
  cashbox_id       BigInt
  category_id      BigInt
  type             transactions_type
  amount           Decimal           @db.Decimal(18, 2)
  description      String?           @db.Text
  reference_no     String?           @db.VarChar(100)
  transaction_date DateTime          @db.Date
  balance_after    Decimal?          @default(0) @db.Decimal(18, 2)
  created_by       BigInt
  created_at       DateTime?         @default(now()) @db.DateTime(0)
  updated_at       DateTime?         @default(now()) @db.DateTime(0)
  cashboxes        cashboxes         @relation(fields: [cashbox_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_transactions_cashbox")
  categories       categories        @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_transactions_category")
  users            users             @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_transactions_user")

  @@index([created_by], map: "fk_transactions_user")
  @@index([cashbox_id], map: "fk_transactions_cashbox")
  @@index([category_id], map: "fk_transactions_category")
}

model users {
  id            BigInt         @id @default(autoincrement())
  username      String         @unique(map: "username") @db.VarChar(100)
  password_hash String         @db.VarChar(255)
  full_name     String         @db.VarChar(255)
  role          users_role
  is_active     Boolean?       @default(true)
  created_at    DateTime?      @default(now()) @db.DateTime(0)
  updated_at    DateTime?      @default(now()) @db.DateTime(0)
  transactions      transactions[]
  treasury_entries  treasury_entries[]
  payroll_months     payroll_months[]
}

model items {
  id         BigInt            @id @default(autoincrement())
  name       String            @db.VarChar(255)
  unit       String            @db.VarChar(50)
  sale_price Decimal?          @db.Decimal(10, 2)
  min_stock  Int               @default(0)
  created_at DateTime?         @default(now()) @db.DateTime(0)
  movements  stock_movements[]
}

model stock_movements {
  id            BigInt    @id @default(autoincrement())
  item_id       BigInt
  movement_type String    @db.VarChar(20)
  quantity      Int
  movement_date DateTime  @db.Date
  notes         String?   @db.Text
  created_at    DateTime? @default(now()) @db.DateTime(0)
  item          items     @relation(fields: [item_id], references: [id])

  @@index([item_id], map: "stock_movements_item_id_fkey")
}


model treasury_accounts {
  id                  BigInt                 @id @default(autoincrement())
  entity_code         String                 @db.VarChar(20)
  name_ar             String                 @db.VarChar(255)
  account_type        String                 @db.VarChar(30)
  opening_balance     Decimal                @default(0) @db.Decimal(18, 2)
  opening_date        DateTime               @db.Date
  is_active           Boolean                @default(true)
  created_at          DateTime?              @default(now()) @db.DateTime(0)
  updated_at          DateTime?              @default(now()) @db.DateTime(0)
  source_lines        treasury_entry_lines[] @relation("TreasurySourceAccount")
  destination_lines   treasury_entry_lines[] @relation("TreasuryDestinationAccount")

  @@index([entity_code])
  @@index([is_active])
}

model treasury_entries {
  id            BigInt                 @id @default(autoincrement())
  entry_date    DateTime               @db.Date
  movement_type String                 @db.VarChar(40)
  beneficiary   String?                @db.VarChar(255)
  description   String?                @db.Text
  category_id   BigInt?
  created_by    BigInt
  is_deleted    Boolean                @default(false)
  created_at    DateTime?              @default(now()) @db.DateTime(0)
  updated_at    DateTime?              @default(now()) @db.DateTime(0)
  user          users                  @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category      categories?            @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines         treasury_entry_lines[]

  @@index([entry_date])
  @@index([movement_type])
  @@index([category_id])
  @@index([created_by])
  @@index([is_deleted])
}

model treasury_entry_lines {
  id                     BigInt             @id @default(autoincrement())
  entry_id               BigInt
  entity_code            String             @db.VarChar(20)
  source_account_id      BigInt?
  destination_account_id BigInt?
  amount                 Decimal            @db.Decimal(18, 2)
  note                   String?            @db.VarChar(500)
  created_at             DateTime?          @default(now()) @db.DateTime(0)
  entry                   treasury_entries  @relation(fields: [entry_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  source_account          treasury_accounts? @relation("TreasurySourceAccount", fields: [source_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destination_account     treasury_accounts? @relation("TreasuryDestinationAccount", fields: [destination_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entry_id])
  @@index([entity_code])
  @@index([source_account_id])
  @@index([destination_account_id])
}

enum transactions_type {
  IN
  OUT
}

enum categories_type {
  INCOME
  EXPENSE
}

enum users_role {
  CEO
  MANAGER
  ACCOUNTANT
  STORE_KEEPER
}


// Monthly salary registers are independent of cashbox and treasury movements.
model payroll_months {
  id          BigInt        @id @default(autoincrement())
  month_key   String        @unique(map: "payroll_month_key_unique") @db.VarChar(7)
  file_name   String?       @db.VarChar(255)
  created_by  BigInt
  created_at  DateTime      @default(now()) @db.DateTime(0)
  updated_at  DateTime      @default(now()) @db.DateTime(0)
  user        users         @relation(fields: [created_by], references: [id])
  rows        payroll_rows[]
}

model payroll_rows {
  id              BigInt         @id @default(autoincrement())
  month_id        BigInt
  employee_key    String         @db.VarChar(255)
  employee_code   String?        @db.VarChar(100)
  employee_name   String         @db.VarChar(255)
  base_salary     Decimal        @default(0) @db.Decimal(18, 2)
  overtime        Decimal        @default(0) @db.Decimal(18, 2)
  allowances      Decimal        @default(0) @db.Decimal(18, 2)
  bonuses         Decimal        @default(0) @db.Decimal(18, 2)
  deductions      Decimal        @default(0) @db.Decimal(18, 2)
  advances        Decimal        @default(0) @db.Decimal(18, 2)
  net_salary      Decimal        @db.Decimal(18, 2)
  notes           String?        @db.VarChar(500)
  month           payroll_months @relation(fields: [month_id], references: [id], onDelete: Cascade)

  @@unique([month_id, employee_key], map: "payroll_month_employee_unique")
  @@index([employee_key])
}

// Annual leave amounts are stored independently so re-importing a month
// cannot accidentally add the leave payment twice.
model payroll_leave_allowances {
  id           BigInt   @id @default(autoincrement())
  year_key     String   @db.VarChar(4)
  employee_key String   @db.VarChar(255)
  amount       Decimal  @default(0) @db.Decimal(18, 2)
  source_file  String?  @db.VarChar(255)
  updated_by   BigInt
  created_at   DateTime @default(now()) @db.DateTime(0)
  updated_at   DateTime @default(now()) @db.DateTime(0)

  @@unique([year_key, employee_key], map: "payroll_leave_year_employee_unique")
}
